{
  "name": "svg-v",
  "displayName": "svgV: SVG to JSX",
  "description": "Paste SVG from Figma and other design tools straight into React as clean JSX.",
  "version": "0.1.0",
  "publisher": "TOLU-MICH",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#2E2A8F",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TOLU-MICH/SVGV.git"
  },
  "bugs": {
    "url": "https://github.com/TOLU-MICH/SVGV/issues"
  },
  "homepage": "https://github.com/TOLU-MICH/SVGV#readme",
  "categories": [
    "Other"
  ],
  "keywords": [
    "svg",
    "jsx",
    "react",
    "tsx",
    "paste",
    "figma",
    "icons",
    "convert",
    "component"
  ],
  "engines": {
    "vscode": "^1.97.0"
  },
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onLanguage:javascript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "svg-v.pasteAsJsx",
        "title": "Paste as JSX",
        "category": "svgV"
      },
      {
        "command": "svg-v.pasteAsComponent",
        "title": "Paste as Component",
        "category": "svgV"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "svg-v.pasteAsJsx",
          "when": "editorLangId =~ /^(typescriptreact|javascriptreact|javascript)$/"
        }
      ]
    },
    "configuration": {
      "title": "svgV",
      "properties": {
        "svg-v.autoPasteEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Convert SVG to JSX automatically when you paste into a React file. When off, use **svgV: Paste as JSX** or **Paste As…** instead."
        },
        "svg-v.includeJsFiles": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also convert pasted SVG in `.js` files. Only turn this on if your project allows JSX in `.js` files."
        },
        "svg-v.prettierEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Format the output with Prettier if it's installed."
        },
        "svg-v.outputFormat": {
          "type": "string",
          "enum": [
            "inline",
            "component"
          ],
          "enumDescriptions": [
            "Paste SVG as inline JSX.",
            "Paste SVG as a React component with an inferred name."
          ],
          "default": "inline",
          "markdownDescription": "What a normal paste inserts. The other option is always available from the paste widget (`Cmd+.` / `Ctrl+.` right after pasting)."
        },
        "svg-v.language": {
          "type": "string",
          "enum": [
            "infer",
            "js",
            "ts"
          ],
          "enumDescriptions": [
            "Typed components in `.tsx` files, untyped elsewhere.",
            "Always untyped.",
            "Always typed with `SVGProps<SVGSVGElement>`."
          ],
          "default": "infer",
          "markdownDescription": "Whether generated components include TypeScript types."
        },
        "svg-v.componentNaming": {
          "type": "string",
          "enum": [
            "prompt",
            "infer"
          ],
          "enumDescriptions": [
            "Ask for a name, suggesting one from the SVG's title or id.",
            "Use the suggested name without asking."
          ],
          "default": "prompt",
          "markdownDescription": "How **Paste as Component** names the component. A normal paste always uses the suggested name."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc -p src/converter",
    "lint": "eslint src",
    "test": "vitest run --dir src/converter && vscode-test",
    "test:unit": "vitest run --dir src/converter",
    "test:unit:watch": "vitest --dir src/converter"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.97.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
