{
  "name": "svg-v",
  "displayName": "svgV: SVG to JSX",
  "description": "Paste SVG from Figma and other design tools straight into React as clean JSX.",
  "keywords": [
    "svg",
    "jsx",
    "react",
    "tsx",
    "paste",
    "figma",
    "icons"
  ],
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onLanguage:javascript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "svg-v.pasteAsJsx",
        "title": "Paste as JSX",
        "category": "SVG to JSX"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "svg-v.pasteAsJsx",
          "when": "editorLangId =~ /^(typescriptreact|javascriptreact|javascript)$/"
        }
      ]
    },
    "configuration": {
      "title": "SVG to JSX",
      "properties": {
        "svg-v.autoPasteEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Convert SVG to JSX automatically when you paste into a React file. When off, use **SVG to JSX: Paste as JSX** or **Paste As…** instead."
        },
        "svg-v.includeJsFiles": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also convert pasted SVG in `.js` files. Only turn this on if your project allows JSX in `.js` files."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc -p tsconfig.unit.json",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "vitest run --dir src/converter",
    "test:unit:watch": "vitest --dir src/converter"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.97.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
